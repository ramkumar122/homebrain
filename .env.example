# Copy to .env for local overrides. Every value has a safe default.
HB_ENV=local
HB_HOST=0.0.0.0
HB_PORT=8080
HB_PUBLIC_BASE_URL=http://localhost:8080
HB_LOG_LEVEL=INFO
# alexa | spec   (Alexa+ wants 401 without WWW-Authenticate; MCP Inspector wants the spec header)
AUTH_401_STYLE=spec
HB_DYNAMODB_TABLE=homebrain
HB_DYNAMODB_ENDPOINT_URL=http://localhost:8000
